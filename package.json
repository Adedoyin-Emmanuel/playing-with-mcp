{
  "name": "nodejs-template",
  "version": "1.0.0",
  "description": "A simple nodejs template for building nodejs applications",
  "main": "./dist/index.js",
  "scripts": {
    "lint": "eslint .",
    "check-lint": "eslint [0-9]*.ts",
    "build": "rimraf ./dist && tsc index.ts --esModuleInterop true --target ES6 --module nodenext --moduleResolution nodenext --outDir dist",
    "start": "npm run build && node ./dist/index.js",
    "dev": "bun --watch index.ts",
    "test": "jest",
    "full-test": "eslint */[0-9]*.ts && jest --watchAll --verbose",
    "full-test-fix": "eslint */[0-9]*.ts --fix && jest --watchAll --verbose",
    "studio": "bunx prisma studio",
    "migrate": "bunx prisma migrate dev",
    "generate": "bunx prisma generate"
  },
  "proxy": true,
  "keywords": [],
  "author": "Adedoyin Emmanuel Adeniyi",
  "license": "MIT",
  "devDependencies": {
    "@babel/core": "^8.0.7",
    "@babel/node": "^8.0.6",
    "@babel/preset-env": "^8.0.7",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-slow-down": "^2.0.0",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.5",
    "eslint": "^10.12.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jest": "^29.16.11",
    "nodemon": "^3.1.14",
    "rimraf": "^6.1.3",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.3.1",
    "axios": "^1.20.0",
    "body-parser": "^2.3.0",
    "cheerio": "^1.2.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "got-scraping": "^4.2.2",
    "helmet": "^8.3.0",
    "joi": "^18.2.9",
    "morgan": "^1.12.1",
    "ts-node": "^10.9.2",
    "tsfluent": "^1.5.2",
    "zod": "^4.6.7"
  }
}
