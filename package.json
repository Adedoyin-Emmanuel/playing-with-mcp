{
  "name": "nodejs-template",
  "version": "1.0.0",
  "description": "A simple nodejs template for building nodejs applications",
  "main": "./dist/http.js",
  "scripts": {
    "lint": "eslint .",
    "check-lint": "eslint [0-9]*.ts",
    "build": "rimraf ./dist && tsc -p .",
    "start": "node --env-file-if-exists=.env ./dist/http.js",
    "dev": "bun --watch index.ts",
    "test": "jest",
    "full-test": "eslint */[0-9]*.ts && jest --watchAll --verbose",
    "full-test-fix": "eslint */[0-9]*.ts --fix && jest --watchAll --verbose",
    "studio": "bunx prisma studio",
    "migrate": "bunx prisma migrate dev",
    "generate": "bunx prisma generate",
    "start:stdio": "node --env-file-if-exists=.env ./dist/index.js"
  },
  "proxy": true,
  "keywords": [],
  "author": "Adedoyin Emmanuel Adeniyi",
  "license": "MIT",
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "eslint": "^10.12.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jest": "^29.16.11",
    "rimraf": "^6.1.3",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "^2.1.1",
    "@modelcontextprotocol/server": "^2.3.1",
    "axios": "^1.20.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "zod": "^4.6.7"
  }
}
